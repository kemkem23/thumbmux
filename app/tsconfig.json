{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@thumbmux/core": ["../core/src"],
      "@thumbmux/svelte": ["../svelte/src"]
    }
  },
  "include": ["src/**/*", "tests/**/*"]
}
