{
  "name": "@thumbmux/app",
  "version": "0.20.0",
  "description": "Mountable Svelte application shell for the thumbmux mobile terminal stack.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "import": "./dist/navigation.js"
    },
    "./overlay": {
      "types": "./dist/overlay.d.ts",
      "import": "./dist/overlay.js"
    },
    "./sessions-store": {
      "types": "./dist/sessions-store.d.ts",
      "import": "./dist/sessions-store.js"
    },
    "./font-range": {
      "types": "./dist/font-range.d.ts",
      "import": "./dist/font-range.js"
    },
    "./embed-config": {
      "types": "./dist/embed-config.d.ts",
      "import": "./dist/embed-config.js"
    }
  },
  "peerDependencies": {
    "svelte": "^5"
  },
  "license": "MIT",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist && svelte-package -i src -o dist"
  },
  "dependencies": {
    "@thumbmux/core": "^0.20.0",
    "@thumbmux/svelte": "^0.20.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.4",
    "svelte": "^5.51.0",
    "svelte2tsx": "^0.7.57",
    "typescript": "^5.9.3"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/kemkem23/thumbmux",
    "directory": "app"
  }
}
