{
  "name": "thumbmux",
  "version": "0.18.6",
  "private": true,
  "type": "module",
  "description": "tmux for thumbs — mobile-first web terminal stack: 120Hz compositor-scroll viewer, keyboard-aware composer dock, and a multiplexed tmux WebSocket engine.",
  "workspaces": [
    "core",
    "svelte",
    "server",
    "app",
    "demo"
  ],
  "repository": "github:kemkem23/thumbmux",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "playwright": "1.61.1",
    "svelte-check": "^4.7.5",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "svelte": "^5"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "types": "./git-dist/core/index.d.ts",
      "import": "./git-dist/core/index.js"
    },
    "./core": {
      "types": "./git-dist/core/index.d.ts",
      "import": "./git-dist/core/index.js"
    },
    "./server": {
      "types": "./git-dist/server/index.d.ts",
      "import": "./git-dist/server/index.js"
    },
    "./svelte": {
      "types": "./git-dist/svelte/index.d.ts",
      "svelte": "./git-dist/svelte/index.js"
    },
    "./app": {
      "types": "./git-dist/app/index.d.ts",
      "svelte": "./git-dist/app/index.js"
    },
    "./svelte/session-grid": {
      "types": "./git-dist/svelte/session-grid.d.ts",
      "import": "./git-dist/svelte/session-grid.js"
    },
    "./svelte/notifications": {
      "types": "./git-dist/svelte/notifications.d.ts",
      "import": "./git-dist/svelte/notifications.js"
    },
    "./svelte/service-worker": {
      "types": "./git-dist/svelte/service-worker.d.ts",
      "import": "./git-dist/svelte/service-worker.js"
    },
    "./svelte/recording-player": {
      "types": "./git-dist/svelte/recording-player.d.ts",
      "import": "./git-dist/svelte/recording-player.js"
    },
    "./svelte/term-search": {
      "types": "./git-dist/svelte/term-search.d.ts",
      "import": "./git-dist/svelte/term-search.js"
    },
    "./svelte/content-update-gate": {
      "types": "./git-dist/svelte/content-update-gate.d.ts",
      "import": "./git-dist/svelte/content-update-gate.js"
    },
    "./app/config": {
      "types": "./git-dist/app/config.d.ts",
      "import": "./git-dist/app/config.js"
    },
    "./app/navigation": {
      "types": "./git-dist/app/navigation.d.ts",
      "import": "./git-dist/app/navigation.js"
    },
    "./app/overlay": {
      "types": "./git-dist/app/overlay.d.ts",
      "import": "./git-dist/app/overlay.js"
    },
    "./app/sessions-store": {
      "types": "./git-dist/app/sessions-store.d.ts",
      "import": "./git-dist/app/sessions-store.js"
    },
    "./package.json": "./package.json",
    "./contract/manifest/*.json": "./contract/manifest/*.json",
    "./CONTRACT.md": "./CONTRACT.md",
    "./docs/*.md": "./docs/*.md"
  },
  "files": [
    "git-dist",
    "docs",
    "CONTRACT.md",
    "contract/manifest"
  ]
}
