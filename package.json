{
  "name": "thumbmux",
  "version": "0.16.3",
  "private": true,
  "type": "module",
  "description": "tmux for thumbs \u2014 mobile-first web terminal stack: 120Hz compositor-scroll viewer, keyboard-aware composer dock, and a multiplexed tmux WebSocket engine.",
  "workspaces": [
    "core",
    "svelte",
    "server",
    "app",
    "demo"
  ],
  "repository": "github:kemkem23/thumbmux",
  "license": "MIT",
  "scripts": {
    "demo": "bun run --cwd demo start",
    "build:packages": "bun run --cwd core build && bun run --cwd server build && bun run --cwd svelte build && bun run --cwd app build",
    "build:git-dist": "bun run build:packages && bun run ./scripts/rewrite-git-dist-imports.ts",
    "smoke:git-dist": "bash ./scripts/smoke-git-dist.sh",
    "prepare": "bun run build:packages",
    "contract": "bun ./scripts/contract-check.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "svelte-check": "^4.7.5",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "svelte": "^5"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "types": "./core/dist/index.d.ts",
      "import": "./core/dist/index.js"
    },
    "./core": {
      "types": "./core/dist/index.d.ts",
      "import": "./core/dist/index.js"
    },
    "./server": {
      "types": "./server/dist/index.d.ts",
      "import": "./server/dist/index.js"
    },
    "./svelte": {
      "types": "./svelte/dist/index.d.ts",
      "svelte": "./svelte/dist/index.js"
    },
    "./app": {
      "types": "./app/dist/index.d.ts",
      "svelte": "./app/dist/index.js"
    },
    "./svelte/session-grid": {
      "types": "./svelte/dist/session-grid.d.ts",
      "import": "./svelte/dist/session-grid.js"
    },
    "./svelte/notifications": {
      "types": "./svelte/dist/notifications.d.ts",
      "import": "./svelte/dist/notifications.js"
    },
    "./svelte/service-worker": {
      "types": "./svelte/dist/service-worker.d.ts",
      "import": "./svelte/dist/service-worker.js"
    },
    "./svelte/recording-player": {
      "types": "./svelte/dist/recording-player.d.ts",
      "import": "./svelte/dist/recording-player.js"
    },
    "./svelte/term-search": {
      "types": "./svelte/dist/term-search.d.ts",
      "import": "./svelte/dist/term-search.js"
    },
    "./svelte/content-update-gate": {
      "types": "./svelte/dist/content-update-gate.d.ts",
      "import": "./svelte/dist/content-update-gate.js"
    },
    "./app/config": {
      "types": "./app/dist/config.d.ts",
      "import": "./app/dist/config.js"
    },
    "./app/navigation": {
      "types": "./app/dist/navigation.d.ts",
      "import": "./app/dist/navigation.js"
    },
    "./app/overlay": {
      "types": "./app/dist/overlay.d.ts",
      "import": "./app/dist/overlay.js"
    },
    "./app/sessions-store": {
      "types": "./app/dist/sessions-store.d.ts",
      "import": "./app/dist/sessions-store.js"
    },
    "./package.json": "./package.json"
  }
}
