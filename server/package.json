{
  "name": "@thumbmux/server",
  "version": "0.21.0",
  "description": "Server side of the thumbmux mobile terminal stack: multiplexed tmux WebSocket engine with pluggable driver and policy hooks (Bun/Node).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./recall": {
      "types": "./dist/recall-handler.d.ts",
      "import": "./dist/recall-handler.js"
    },
    "./sqlite-history": {
      "types": "./dist/sqlite-history.d.ts",
      "import": "./dist/sqlite-history.js"
    },
    "./pipe-history-runtime": {
      "types": "./dist/pipe-history-runtime.d.ts",
      "import": "./dist/pipe-history-runtime.js"
    },
    "./projection-store": {
      "types": "./dist/sqlite-history/projection-store.d.ts",
      "import": "./dist/sqlite-history/projection-store.js"
    },
    "./projection-reader": {
      "types": "./dist/sqlite-history/projection-reader.d.ts",
      "import": "./dist/sqlite-history/projection-reader.js"
    },
    "./projection-schema": {
      "types": "./dist/sqlite-history/schema.d.ts",
      "import": "./dist/sqlite-history/schema.js"
    },
    "./projection-types": {
      "types": "./dist/sqlite-history/types.d.ts",
      "import": "./dist/sqlite-history/types.js"
    },
    "./history-row-matcher": {
      "types": "./dist/history-row-matcher.d.ts",
      "import": "./dist/history-row-matcher.js"
    }
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!**/__pycache__",
    "!**/*.pyc",
    "!**/*.pyo"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/terminal-replay-worker-entry.ts src/recall-handler.ts src/sqlite-history.ts src/pipe-history-runtime.ts src/sqlite-history/projection-store.ts src/sqlite-history/projection-reader.ts src/sqlite-history/schema.ts src/sqlite-history/types.ts src/history-row-matcher.ts --root src --outdir dist --target node --external @thumbmux/core && tsc -p tsconfig.build.json && bun run ./scripts/copy-runtime-assets.ts"
  },
  "dependencies": {
    "@thumbmux/core": "^0.21.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/bun": "^1.3.0"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/kemkem23/thumbmux",
    "directory": "server"
  }
}
